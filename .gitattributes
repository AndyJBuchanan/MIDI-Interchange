# Normalise line endings in the repo regardless of each machine's core.autocrlf.
* text=auto
# Shell scripts must keep LF even in a Windows checkout (a CRLF checkout copied to a Mac breaks bash).
*.sh text eol=lf
*.env text eol=lf
*.example text eol=lf
# Windows PowerShell scripts conventionally use CRLF.
*.ps1 text eol=crlf
# Binary fixtures
*.mid binary
