{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create .venv and install deps",
      "type": "shell",
      "command": "python3.12 -m venv .venv && .venv/bin/python -m pip install -U pip && .venv/bin/python -m pip install -r requirements.txt -r requirements-dev.txt",
      "windows": {
        "command": "py -3.12 -m venv .venv; .venv\\Scripts\\python -m pip install -U pip; .venv\\Scripts\\python -m pip install -r requirements.txt -r requirements-dev.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "Generate demo samples",
      "type": "shell",
      "command": ".venv/bin/python tools/make_demo_midi.py",
      "windows": { "command": ".venv\\Scripts\\python tools/make_demo_midi.py" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run app",
      "type": "shell",
      "command": ".venv/bin/python main.py",
      "windows": { "command": ".venv\\Scripts\\python main.py" },
      "problemMatcher": []
    },
    {
      "label": "Build standalone app",
      "type": "shell",
      "command": "bash scripts/build_macos.sh",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File scripts\\build_windows.ps1" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
