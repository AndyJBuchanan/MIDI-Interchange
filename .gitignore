samples/project-cubase-phases/Verify/Scaler3Test-001(14).cpr

# Samples kept out of git (see samples/README.md):
# local/   files tests use when present but too big to commit (tests skip when absent)
# _archive/ material not kept in the repo, gathered for the user to archive elsewhere
samples/local/
samples/_archive/
