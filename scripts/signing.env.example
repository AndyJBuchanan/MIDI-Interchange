# Copy to scripts/signing.local.env (git-ignored) and fill in. Sourced by scripts/build_macos.sh.
#
# Developer ID Application identity: SHA-1 hash or full name, from
#   security find-identity -v -p codesigning
CODESIGN_IDENTITY="<SHA-1 of your Developer ID Application certificate>"

# notarytool keychain profile name. Create it once per machine (it prompts for credentials;
# use an app-specific password from appleid.apple.com, or an App Store Connect API key):
#   xcrun notarytool store-credentials "<profile-name>" --apple-id "<developer account sign-in email>" --team-id "<TEAMID>"
NOTARY_KEYCHAIN_PROFILE="<profile-name>"
